import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
        for(int i=1;i<=n;i++){
            int end = 2*i-1;
            for(int j=1;j<=end;j++){
                System.out.print(j);
            }
            System.out.println();
        }
    }
}
